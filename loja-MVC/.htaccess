Options -Indexes

DirectoryIndex public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloqueia arquivos ocultos (.env, .git, etc.)
    RewriteRule (^|/)\. - [F,L]

    # Bloqueia acesso direto às áreas internas da aplicação
    RewriteRule ^(app|config|database|models|routes|scripts|services|storage|tests|views)(/|$) - [F,L,NC]

    # Permite arquivos e diretórios públicos reais
    # (ex.: public/assets)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todas as rotas da aplicação passam pelo Front Controller
    RewriteRule ^ public/index.php [QSA,L]
</IfModule>
